# Browser mode is single-user and localhost-only. No Meta credentials required.
MODE=browser
DATABASE_URL=sqlite:///./instacomment.db
FRONTEND_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
# Optional. A stable signing secret is generated in backend/.local otherwise.
SESSION_SECRET=
# Uses installed Google Chrome by default. Or: chromium after npm run browser:install.
BROWSER_CHANNEL=chrome
